# Copy to .env (never commit .env)
DB_USER=smartdesk
DB_PASSWORD=smartdesk
DB_PORT=5432

# Used by later services
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
JWT_SECRET=put-any-long-random-text-of-at-least-32-characters
# Shared secret for ticket-service -> api-gateway /internal/users lookups (same value in both)
INTERNAL_API_KEY=change-me
# true = login/register responses include the OTP (Postman demo). Must be false in production.
OTP_EXPOSE=true
